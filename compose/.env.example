# Template de variaveis — NAO use valores reais aqui
# Fonte de verdade: compose/sops-secrets.yaml (SOPS/age).
# Regere o .env real com: bash scripts/decrypt-secrets.sh
# Edite secrets com: sops compose/sops-secrets.yaml

# Timezone (formato IANA: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Sao_Paulo

# MariaDB (banco central: Home Assistant, Forgejo, CrowdSec, Vaultwarden)
MARIADB_ROOT_PASSWORD=exemplo-root-senha
MARIADB_DATABASE=homeassistant
MARIADB_USER=ha_user
MARIADB_PASSWORD=exemplo-ha-senha
# Senhas dos bancos das apps no MariaDB central (bancos/usuarios criados em compose/database-init/ no primeiro boot)
FORGEJO_DB_PASSWORD=exemplo-forgejo-db-senha
CROWDSEC_DB_PASSWORD=exemplo-crowdsec-db-senha
# Vaultwarden usa o MariaDB central (banco/usuarios criados em compose/database-init/ no primeiro boot)
VAULTWARDEN_DB_PASSWORD=exemplo-vaultwarden-db-senha

# Home Assistant location (exemplo: Brasilia)
HOMEASSISTANT_LATITUDE=-15.78
HOMEASSISTANT_LONGITUDE=-47.93
HOMEASSISTANT_ELEVATION=1172

# ESPHome dashboard credentials
ESPHOME_USERNAME=admin
ESPHOME_PASSWORD=exemplo-esphome-senha

# Mumble (VoIP) — superuser password (chave usada pelo compose: MUMBLE_CONFIG_supw)
MUMBLE_CONFIG_supw=exemplo-mumble-senha
MUMBLE_DB_PASSWORD=exemplo-mumble-db-senha
# Usado só por scripts/mumble-setup.sh para exibir o endereço de conexão (opcional)
MUMBLE_PUBLIC_HOST=exemplo.dominio.ou.ip

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=exemplo-grafana-senha

# Frigate (NVR) — acesso via https://frigate.home (basicAuth via bcrypt em traefik/dynamic.yml)
# Senha RTSP das cameras (opcional; usada em frigate/config.yml como {FRIGATE_RTSP_PASSWORD}). Vazia = sem auth.
# Centralizada no sops (compose/sops-secrets.yaml).
FRIGATE_RTSP_PASSWORD=

GRAFANA_DB_PASSWORD=EXEMPLO_GRAFANA_DB

# Vaultwarden (senhas) — acesso https://vault.home (sem portas expostas; admin em /admin)
# Admin token: gerar novo com: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=exemplo-vaultwarden-admin-token
# URL completa do MariaDB (percent-encode na senha). Deve usar a MESMA senha de VAULTWARDEN_DB_PASSWORD
VAULTWARDEN_DATABASE_URL=mysql://vaultwarden:senha_encoded@mariadb/vaultwarden

# Home Assistant webhook p/ CrowdSec (recebe alertas de ban)
HA_WEBHOOK_ID=crowdsec_alerts

# Tailscale — auth key p/ conectar o host a rede mesh
# Criar em https://login.tailscale.com/admin/settings/keys
# (reusable, ephemeral=false, pre-approved=true, tags=tag:homelab)
TAILSCALE_AUTHKEY=tskey-auth-exemplo

# OmniRoute (Free MIT AI Gateway) — 339 providers, 1200+ models
# Necessita de segredos: OMNIROUTE_INITIAL_PASSWORD (via sops), TZ do .env compartilhado.
# Dashboard: https://omniroute.home (via Traefik)
# API OpenAI-compat: https://omniroute.home/v1 (use como baseURL no cliente)
# Perfil 'base' usado (imagem minima sem CLI tools). Para web/CLI tools: veja docker-compose.yml upstream.
# Se usar Tailscale Funnel: ajuste LIVE_WS_ALLOWED_ORIGINS no compose e adicione sidecar ts-omniroute.
# Docs: https://github.com/diegosouzapw/OmniRoute/blob/release/v3.8.50/docs/guides/DOCKER_GUIDE.md
