# Template com valores de exemplo (NAO use em producao)
# Copie para .env ou gere via: bash scripts/decrypt-secrets.sh

# Timezone (formato IANA: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Sao_Paulo

# Domain for Caddy reverse proxy (set to your actual domain or IP)
DOMAIN=example.com

# MariaDB credentials (substitua por senhas fortes)
MARIADB_ROOT_PASSWORD=exemplo-root-senha
MARIADB_DATABASE=homeassistant
MARIADB_USER=ha_user
MARIADB_PASSWORD=exemplo-ha-senha

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=exemplo-grafana-senha

# Home Assistant location (exemplo: Brasilia)
HOMEASSISTANT_LATITUDE=-15.78
HOMEASSISTANT_LONGITUDE=-47.93
HOMEASSISTANT_ELEVATION=1172

# Mumble server superuser password
MUMBLE_SUPERUSER_PASSWORD=exemplo-mumble-senha

# ESPHome dashboard credentials
ESPHOME_USERNAME=admin
ESPHOME_PASSWORD=exemplo-esphome-senha
