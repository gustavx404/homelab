# Template com valores de exemplo (NAO use em producao)
# Copie para .env ou gere via: bash scripts/decrypt-secrets.sh

# Timezone (formato IANA: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Sao_Paulo

# Domain for Traefik reverse proxy (set to your actual domain or IP)
DOMAIN=example.com

# MariaDB credentials (substitua por senhas fortes)
MARIADB_ROOT_PASSWORD=exemplo-root-senha
MARIADB_DATABASE=homeassistant
MARIADB_USER=ha_user
MARIADB_PASSWORD=exemplo-ha-senha

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=exemplo-grafana-senha

# Home Assistant location (exemplo: Brasilia)
HOMEASSISTANT_LATITUDE=-15.78
HOMEASSISTANT_LONGITUDE=-47.93
HOMEASSISTANT_ELEVATION=1172

# Mumble server superuser password
MUMBLE_SUPERUSER_PASSWORD=exemplo-mumble-senha

# ESPHome dashboard credentials
ESPHOME_USERNAME=admin
ESPHOME_PASSWORD=exemplo-esphome-senha

# Immich (fotos) — acesso via https://photos.home (Traefik host-based; subpath nao suportado)
IMMICH_VERSION=v3.1.0
IMMICH_DB_USERNAME=postgres
IMMICH_DB_NAME=immich
IMMICH_DB_PASSWORD=exemplo-immich-senha
# Caminhos de armazenamento (relativos a compose/). Se ausentes no .env,
# o compose usa os defaults: ../data/immich/library e ../data/immich/postgres
UPLOAD_LOCATION=../data/immich/library
DB_DATA_LOCATION=../data/immich/postgres

# Frigate (NVR) — acesso via https://<ip>/frigate (login basicAuth FRIGATE_AUTH_* em sops)
# Credenciais das câmeras RTSP (opcional; usada no config.yml via env_var)
FRIGATE_RTSP_PASSWORD=

# Homepage dashboard
HOMEPAGE_HA_KEY=seu-token-longa-duracao-ha
