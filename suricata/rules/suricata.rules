# Suricata rules — scan detection + basic protection
# Run `bash scripts/update-suricata-rules.sh` to download the full ET Open ruleset

# ============================================================
# ICMP / Ping
# ============================================================

# ICMP ping (single)
alert icmp any any -> $HOME_NET any (msg:"ICMP echo request (ping)"; \
  itype:8; sid:1000001; rev:2;)

# ICMP sweep (10+ hosts in 30s)
alert icmp any any -> $HOME_NET any (msg:"ICMP ping sweep detected"; \
  itype:8; threshold:type threshold, track by_src, count 10, seconds 30; \
  sid:1000003; rev:1;)

# ============================================================
# TCP Scan Detection
# ============================================================

# SYN scan (nmap -sS): TCP SYN to many ports without completing handshake
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"TCP SYN scan detected"; \
  flags:S; flow:stateless; \
  threshold:type both, track by_src, count 15, seconds 5; \
  sid:1000010; rev:1;)

# Connect scan (nmap -sT): rapid completed TCP connections to many ports
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"TCP connect() scan detected"; \
  flow:to_server,established; \
  threshold:type both, track by_src, count 15, seconds 5; \
  sid:1000011; rev:1;)

# NULL scan (nmap -sN): TCP with no flags set
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"TCP NULL scan detected"; \
  flags:0; flow:stateless; \
  threshold:type threshold, track by_src, count 5, seconds 10; \
  sid:1000012; rev:1;)

# FIN scan (nmap -sF): TCP FIN without ACK
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"TCP FIN scan detected"; \
  flags:F; flow:stateless; \
  threshold:type threshold, track by_src, count 5, seconds 10; \
  sid:1000013; rev:1;)

# XMAS scan (nmap -sX): FIN+PSH+URG flags
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"TCP XMAS scan detected"; \
  flags:FPU; flow:stateless; \
  threshold:type threshold, track by_src, count 5, seconds 10; \
  sid:1000014; rev:1;)

# ============================================================
# Port Scan (general — aggressive probing)
# ============================================================

# High-rate port probing (50+ unique ports in 10s)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Aggressive port scan detected"; \
  flow:stateless; \
  threshold:type both, track by_src, count 50, seconds 10; \
  sid:1000020; rev:1;)

# ============================================================
# UDP Scan
# ============================================================

# UDP scan: rapid UDP packets to many ports
alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"UDP scan detected"; \
  threshold:type both, track by_src, count 10, seconds 5; \
  sid:1000030; rev:1;)

# ============================================================
# Service-Specific Intrusion Attempts
# ============================================================

# SSH brute force (5+ connections in 60s)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SSH brute force detected"; \
  flow:to_server,established; \
  threshold:type threshold, track by_src, count 5, seconds 60; \
  sid:1000040; rev:2;)

# HTTP directory traversal attempt
alert tcp $EXTERNAL_NET any -> $HOME_NET [80,443,8080,8123] (msg:"HTTP path traversal attempt"; \
  flow:to_server,established; content:"../"; http_uri; \
  sid:1000050; rev:1;)

# HTTP SQL injection probe
alert tcp $EXTERNAL_NET any -> $HOME_NET [80,443,8080,8123] (msg:"HTTP SQL injection probe"; \
  flow:to_server,established; \
  content:"union"; nocase; http_uri; \
  content:"select"; nocase; http_uri; distance:0; \
  sid:1000051; rev:1;)
