ant;}.btn.btn-primary.stroke {border-color:#f45a1c !important;color:#f45a1c !important;}.btn.btn-primary.stroke:hover {border-color:#ff6900 !important;color:#ff6900 !important;}.btn.btn-secondary,.btn.btn-secondary:active,.btn.btn-secondary:focus {background-color:#695d4f !important;border-color:#695d4f !important;}.btn.btn-secondary:hover {background-color:#958471 !important;border-color:#958471 !important;}.btn.btn-secondary.stroke {border-color:#695d4f !important;}.btn.btn-secondary.stroke:hover {border-color:#958471 !important;}.copyright {color:#ece8df;font-size:0.75rem;text-align:center;}
